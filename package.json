{
  "name": "@nuxt/image",
  "version": "2.2.1",
  "description": "Nuxt Image Module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuxt/image.git"
  },
  "homepage": "https://image.nuxt.com",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/module.js",
    "./runtime": "./dist/runtime/index.js",
    "./runtime/providers/*": "./dist/runtime/providers/*.js"
  },
  "main": "./dist/module.js",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/module.d.ts"
      ],
      "./runtime": [
        "./dist/runtime/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "dev": "nuxt dev playground",
    "dev:v5": "pnpm --filter ./playground-v5 dev",
    "dev:build": "nuxt build playground",
    "dev:generate": "nuxt generate playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare docs",
    "docs:build": "pnpm run --filter docs build",
    "docs:dev": "pnpm run --filter docs dev",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "prepack": "nuxt-module-build prepare && pnpm build",
    "test": "nuxt prepare playground && pnpm vitest run --coverage",
    "test:types": "vue-tsc --noEmit",
    "test:built:types": "nuxt typecheck playground && nuxt typecheck example"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@nuxt/kit": "^4.6.2",
    "defu": "^6.1.7",
    "h3": "^1.15.11",
    "image-meta": "^0.3.0",
    "knitwork": "^1.3.0",
    "ohash": "^2.0.12",
    "pathe": "^2.0.3",
    "std-env": "^4.3.0",
    "ufo": "^1.6.4"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "1.17.0",
    "@nuxt/module-builder": "1.0.3",
    "@nuxt/schema": "4.6.2",
    "@nuxt/test-utils": "^4.3.4",
    "@types/node": "^24.19.2",
    "@unhead/vue": "^3.4.3",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "changelogen": "^0.6.2",
    "eslint": "10.13.0",
    "happy-dom": "^20.14.6",
    "installed-check": "^11.0.0",
    "ipx": "^4.0.0",
    "knip": "^6.41.0",
    "nitropack": "^2.13.4",
    "nuxt": "^4.6.2",
    "pkg-pr-new": "^0.0.91",
    "playwright-core": "^1.64.1",
    "tinyglobby": "^0.2.17",
    "typescript": "6.0.3",
    "unbuild": "^3.6.1",
    "vitest": "^5.0.5",
    "vue": "3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "optionalDependencies": {
    "ipx": "^4.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
