{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "build.config.ts",
        "src/module.ts",
        "src/runtime/index.ts",
        "src/runtime/components/**",
        "src/runtime/composables/**",
        "src/runtime/plugins/**",
        "src/runtime/providers/**",
        "src/runtime/server/**",
        "test/**/*.test.ts"
      ],
      "ignoreUnresolved": [
        "#internal/nuxt-image"
      ],
      "ignoreDependencies": []
    },
    "example": {
      "ignoreDependencies": [
        "@nuxt/image"
      ]
    },
    "playground": {
      "entry": [
        "app/providers/custom/index.ts",
        "app/{components,layouts,pages,plugins,server}/**",
        "app/{app,error}.vue",
        "layers/**",
        "*.ts"
      ]
    }
  }
}
